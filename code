<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Constellia Clicker</title>
    <style>
        :root { 
            --mana-blue: #00d4ff; 
            --star-silver: #e0e0e0;
            --void-purple: #1a0b2e;
            --exp-gold: #ffd700;
        }
        body { 
            background-color: #050208; color: var(--mana-blue); 
            font-family: 'Garamond', serif; 
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
            min-height: 100vh; margin: 0; padding: 20px;
            background-image: radial-gradient(circle at center, #1a0b2e 0%, #050208 100%);
            transition: background 0.5s;
            overflow-x: hidden;
        }

        /* Mage Gauge Styling */
        .mage-container {
            position: relative;
            width: 300px;
            height: 300px;
            margin-bottom: 20px;
            z-index: 2;
        }
        #mageGauge {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: grayscale(100%) brightness(0.5);
            transition: filter 0.5s ease, transform 0.2s ease;
        }

        /* Quest Animation Effects */
        .flash-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: white; opacity: 0; pointer-events: none; z-index: 99;
        }

        @keyframes castFlash {
            0% { opacity: 0; }
            20% { opacity: 0.6; background: var(--mana-blue); }
            100% { opacity: 0; }
        }
        @keyframes shake {
            0% { transform: translate(0,0); }
            25% { transform: translate(5px, -5px); }
            50% { transform: translate(-5px, 5px); }
            75% { transform: translate(5px, 5px); }
            100% { transform: translate(0,0); }
        }
        .animating-flash { animation: castFlash 0.8s ease-out; }
        .animating-shake { animation: shake 0.4s ease-in-out infinite; }

        .constellia-box { 
            border: 2px solid var(--mana-blue); padding: 30px; background: rgba(5, 2, 8, 0.9); 
            width: 480px; text-align: center; border-radius: 15px;
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.15); z-index: 10;
        }
        
        .mana-display { font-size: 2.2rem; font-weight: bold; margin: 10px 0; color: #fff; text-shadow: 0 0 15px var(--mana-blue); }
        .sp-display { color: var(--exp-gold); font-size: 1rem; letter-spacing: 2px; margin-bottom: 20px; }
        #output { font-size: 1.1rem; margin: 15px 0; min-height: 80px; color: var(--star-silver); line-height: 1.4; }
        
        .btn-group { display: flex; flex-direction: column; gap: 10px; }
        button { 
            background: rgba(0, 212, 255, 0.05); color: var(--mana-blue); border: 1px solid var(--mana-blue); 
            padding: 12px; cursor: pointer; text-transform: uppercase; width: 100%; 
            transition: 0.3s; letter-spacing: 2px; font-weight: bold; border-radius: 5px;
        }
        button:hover:not(:disabled) { background: var(--mana-blue); color: #000; box-shadow: 0 0 20px var(--mana-blue); }
        button:disabled { border-color: #444; color: #444; cursor: not-allowed; opacity: 0.5; }

        .upgrade-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 20px; }
        .upgrade-card { border: 1px solid rgba(255, 215, 0, 0.3); padding: 10px; font-size: 0.8rem; border-radius: 5px; background: rgba(0,0,0,0.3); }

        .history-container {
            width: 480px; background: rgba(0, 0, 0, 0.5); border: 1px solid #222;
            margin-top: 20px; padding: 15px; font-size: 0.85rem; color: #888; border-radius: 10px;
        }
        
        @keyframes pulse {
            0% { filter: drop-shadow(0 0 5px var(--mana-blue)); }
            50% { filter: drop-shadow(0 0 20px var(--mana-blue)); }
            100% { filter: drop-shadow(0 0 5px var(--mana-blue)); }
        }
        .charged { animation: pulse 2s infinite ease-in-out; }
    </style>
</head>
<body onload="init()">

<div class="flash-overlay" id="flash"></div>

<div class="mage-container">
    <img src="image_2a4d99.jpg" id="mageGauge" alt="Mana Mage">
</div>

<div class="constellia-box">
    <div class="mana-display" id="manaView">0 MANA</div>
    <div class="sp-display" id="spView">SKILL POINTS: 0</div>
    
    <div id="output">Concentrate your focus...</div>
    
    <div class="btn-group" id="btnArea">
        <button onclick="clickMana()">Channel Mana</button>
        <button onclick="offerQuest()" id="questBtn">Embark on Quest</button>
    </div>

    <div class="upgrade-grid">
        <div class="upgrade-card">
            <div>Click Mastery (Lvl <span id="lvlClick">0</span>)</div>
            <button onclick="buyUpgrade('click')" id="btnClick">Upgrade (1 SP)</button>
        </div>
        <div class="upgrade-card">
            <div>Auto Scribing (Lvl <span id="lvlAuto">0</span>)</div>
            <button onclick="buyUpgrade('auto')" id="btnAuto">Upgrade (1 SP)</button>
        </div>
    </div>
</div>

<div class="history-container">
    <div id="historyList"></div>
</div>

<script>
    let gameState = { mana: 0, sp: 0, logs: [], cycles: 0, upgrades: { click: 0, auto: 0 } };

    function init() {
        const saved = JSON.parse(localStorage.getItem('constelliaData'));
        if (saved) gameState = saved;
        setInterval(() => { gameState.mana += (gameState.upgrades.auto * 1.5); updateDisplay(); }, 1000);
        updateDisplay();
        renderLog();
    }

    function clickMana() {
        gameState.mana += (1 + (gameState.upgrades.click * 2));
        updateDisplay();
    }

    function updateDisplay() {
        const cost = Math.floor(50 * (1 + (gameState.cycles * 0.5)));
        const manaRatio = Math.min(gameState.mana / cost, 1);
        const img = document.getElementById('mageGauge');
        
        img.style.filter = `grayscale(${100 - (manaRatio * 100)}%) brightness(${0.5 + (manaRatio * 0.5)})`;
        manaRatio >= 1 ? img.classList.add('charged') : img.classList.remove('charged');

        document.getElementById('manaView').innerText = `${Math.floor(gameState.mana)} MANA`;
        document.getElementById('spView').innerText = `SKILL POINTS: ${gameState.sp}`;
        document.getElementById('lvlClick').innerText = gameState.upgrades.click;
        document.getElementById('lvlAuto').innerText = gameState.upgrades.auto;
        document.getElementById('questBtn').innerText = `Embark on Quest (${cost} Mana)`;
        document.getElementById('btnClick').disabled = gameState.sp < 1;
        document.getElementById('btnAuto').disabled = gameState.sp < 1;
        save();
    }

    function offerQuest() {
        const cost = Math.floor(50 * (1 + (gameState.cycles * 0.5)));
        if (gameState.mana < cost) return;
        gameState.mana -= cost;
        const taskText = "Seal the rift in the 5th Layer of the Nebula";
        document.getElementById('output').innerHTML = `Quest Active:<br><strong>${taskText}</strong>`;
        document.getElementById('btnArea').innerHTML = `
            <button onclick="clickMana()">Channel Mana</button>
            <button onclick="triggerQuestAnimation('${taskText}')">Complete Quest</button>
        `;
        updateDisplay();
    }

    function triggerQuestAnimation(text) {
        const overlay = document.getElementById('flash');
        const mage = document.getElementById('mageGauge');
        
        // Start Animations
        overlay.classList.add('animating-flash');
        mage.classList.add('animating-shake');

        // Cleanup and finish quest after animation peak
        setTimeout(() => {
            overlay.classList.remove('animating-flash');
            mage.classList.remove('animating-shake');
            completeQuest(text);
        }, 800);
    }

    function completeQuest(text) {
        gameState.logs.push(text);
        gameState.sp += 1;
        if (gameState.logs.length >= 7) {
            document.getElementById('output').innerHTML = "ASCENSION READY";
            document.getElementById('btnArea').innerHTML = `<button onclick="ascend()">Ascend</button>`;
        } else {
            document.getElementById('output').innerText = "Trial recorded. Skill point absorbed.";
            document.getElementById('btnArea').innerHTML = `
                <button onclick="clickMana()">Channel Mana</button>
                <button onclick="offerQuest()">Embark on Quest</button>
            `;
        }
        renderLog();
        updateDisplay();
    }

    function buyUpgrade(type) {
        if (gameState.sp >= 1) { gameState.sp -= 1; gameState.upgrades[type]++; updateDisplay(); }
    }

    function ascend() {
        gameState.cycles++; gameState.logs = []; gameState.mana = 0;
        document.getElementById('btnArea').innerHTML = `<button onclick="clickMana()">Channel Mana</button><button onclick="offerQuest()">Embark on Quest</button>`;
        updateDisplay(); renderLog();
    }

    function save() { localStorage.setItem('constelliaData', JSON.stringify(gameState)); }
    function renderLog() {
        const list = document.getElementById('historyList');
        list.innerHTML = gameState.logs.length === 0 ? "No records found." : 
            gameState.logs.map((log, i) => `<div style="margin-bottom:5px">Deed ${i+1}: ${log}</div>`).join('');
    }
</script>
</body>
</html>
